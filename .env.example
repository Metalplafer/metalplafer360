# ==========================================================================
# METALPLAFER360 · Variables de entorno del FRONTEND
#
# EN LOCAL:  copia este archivo como ".env" y rellena los dos primeros valores.
# EN GITHUB: Settings > Secrets and variables > Actions > pestaña "Variables".
#
# Estas variables son PÚBLICAS (viajan al navegador). Es correcto y seguro:
# la seguridad real la aplican las políticas RLS de la base de datos.
# NUNCA pongas aquí la clave "service_role" ni credenciales de Google.
# ==========================================================================

# Supabase > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase > Project Settings > API Keys > anon / public
VITE_SUPABASE_ANON_KEY=PEGA_AQUI_LA_CLAVE_ANON

# Dominio interno para entrar solo con el nombre de usuario.
# Ejemplo: el usuario "juan" inicia sesión como juan@metalplafer.com.
# No se envía ningún correo electrónico: es solo un identificador.
VITE_LOGIN_DOMAIN=metalplafer.com
